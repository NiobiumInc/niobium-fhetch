@PACKAGE_INIT@

# Niobium::fhetch_binding: bind and output limbs (niobium/binding.h). C++20; links
# Niobium::fhetch_formats and nbbf::nbbf, found here so a consumer needs only
# find_package(NiobiumFhetchBinding). The formats package installs beside this one.
include(CMakeFindDependencyMacro)
find_dependency(NiobiumFhetchFormats HINTS "${CMAKE_CURRENT_LIST_DIR}/../NiobiumFhetchFormats")
find_dependency(nbbf 1.0)

include("${CMAKE_CURRENT_LIST_DIR}/NiobiumFhetchBindingTargets.cmake")
check_required_components(NiobiumFhetchBinding)
